# Proveedor LLM: "gemini" o "mock".
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Modelo actual recomendado para Gemini 3+/4: "auto" (descubre el modelo
# disponible con mejor puntuacion para generacion de contenido) o un ID exacto,
# por ejemplo "gemini-4-hydrogen", "gemini-3.8-flash", "gemini-3.6-flash".
GEMINI_MODEL=auto
# Fallbacks usados si el modelo preferido o la autodeteccion no estan disponibles.
GEMINI_MODEL_FALLBACKS=gemini-4-hydrogen,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# Nivel de pensamiento: "low", "medium" o "high" (Gemini 4 Hydrogen acepta "xhigh").
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=2048

# Puerto del backend
PORT=3001

# Limites de costo y de ciclo del agente
MAX_ITERACIONES_TOOL=25
MAX_HERRAMIENTAS_POR_TURNO=12
MAX_TOKENS_SESION=60000
MAX_TOKENS_SALIDA=2048
MAX_TOKENS_DIA=200000
MAX_CONCURRENT_CHATS=4

# Opcional: ruta de escritura para out/ (en serverless usar /tmp/out)
# OUT_DIR=

# Opcional: origenes permitidos para peticiones cross-origin (separar con coma).
# Vacio = solo mismo origen. Ej: https://mi-front.azurestaticapps.net
# APP_ORIGINS=

# Opcional: confianza en proxy (1 en Render/tuneles, 0 en exposicion directa).
TRUST_PROXY=1
